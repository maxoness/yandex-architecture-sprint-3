@startuml
title SmartHouse System / DeviceControlService Component Diagram

top to bottom direction

!includeurl ../C4_templates/C4_Component.puml

Container_Boundary(ControllerManagementServices, "Управление контроллерами систем умного дома") {
  Container(DeviceControlService, DeviceControlService, "Java, Spring", "Получение и исполнение команд управления умными устройствами, \n а также предоставление истории команд и состояний")
  ContainerDb(DeviceControlDatabase, DeviceControlDatabase, "Cassandra", "Хранит историю управления умными устройствами и их состояний")
  ContainerQueue(ControlCommandsQueue, ControlCommandsQueue, "Kafka", "Топики для отправки управляющие команд на умные устройства и получения результатов выполнения")

  Container(ProtocolControlService, ProtocolControlService, "Java, Spring", "Непосредственное протокольное взаимодействие с умными устройствами")
}

Container(DeviceControlService, "DeviceControlService") {
    Component(DeviceControlController, "DeviceControl \n Controller", "REST Controller", "Принимает запросы на управление умными устройствами, на получение истории команд и состояний устройств")
    Component(DeviceControlServiceLayer, "DeviceControl \n Service Layer", "Business logic", "Реализует бизнес логику управления устройствами, а также получения истории команд и состояний устройств")
    Component(DeviceControlRepository, "DeviceControl \n Repository Layer", "Data access logic", "Реализует логику доступа к данным и их изменения")
    Component(DeviceStatusRepository, "DeviceStatus \n Repository Layer", "Data access logic", "Реализует логику доступа к данным и их изменения")
    Component(DeviceControlKafkaProducer, "DeviceControl \n KafkaProducer", "Kafka Producer", "Отправляет управляющие команды в топик кафки")
    Component(DeviceControlKafkaListener, "DeviceControl \n KafkaListener", "Kafka Listener", "Читает результаты выполнения команд из топика кафки")
}



Rel(DeviceControlController,DeviceControlServiceLayer,"Обрабатывает запрос")
Rel(DeviceControlServiceLayer,DeviceControlRepository,"Получает/изменяет данные команд")
Rel(DeviceControlServiceLayer,DeviceStatusRepository,"Получает/изменяет данные статусов")
Rel(DeviceControlRepository,DeviceControlDatabase,"Читает/изменяет историю команд устройств")
Rel(DeviceStatusRepository,DeviceControlDatabase,"Читает/изменяет историю состояний устройств")
Rel(DeviceControlServiceLayer,DeviceControlKafkaProducer,"Получает/изменяет данные")
Rel(DeviceControlKafkaListener,DeviceControlServiceLayer,"Обрабатывает полученные результаты выполнения команд")
Rel(DeviceControlKafkaProducer,ControlCommandsQueue,"Отправляет управляющие команды в топик кафки", "async")
Rel(DeviceControlKafkaListener,ControlCommandsQueue,"Читает результаты выполнения команд из топика кафки", "async")

Rel(DeviceControlServiceLayer,ProtocolControlService,"Синхронная отправка управляющей команды на устройство", "sync")
Rel(DeviceControlServiceLayer,ProtocolControlService,"Синхронное получение состояния устройства", "sync")


@enduml